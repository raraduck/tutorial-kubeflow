FROM docker.io/nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

# ── 환경 변수 ────────────────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64

# ── 1. 시스템 패키지 ─────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3-pip \
        python3.12-dev \
        python3.12-venv \
        libgl1 \
        libglx-mesa0 \
        libglib2.0-0 \
        git \
        build-essential \
        curl \
        ca-certificates \
        gnupg \
        sudo \
        net-tools \
        wget \
        vim \
        htop \
        openssh-server \
        # Kubeflow notebook server 요구사항
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3

# ── 2. pip 전역 설정 (break-system-packages 영구 적용) ──────────────────────
RUN mkdir -p /etc/pip \
    && echo "[global]" > /etc/pip.conf \
    && echo "break-system-packages = true" >> /etc/pip.conf

# ── 3. Node.js 20 설치 ──────────────────────────────────────────────────────
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── 4. code-server 설치 ─────────────────────────────────────────────────────
ARG CODE_SERVER_VERSION=4.92.2
RUN curl -fsSL https://code-server.dev/install.sh \
    | sh -s -- --version=${CODE_SERVER_VERSION} \
    && rm -rf /root/.cache

# ── 5. Claude Code + GitHub Copilot CLI 전역 설치 ───────────────────────────
RUN npm install -g @anthropic-ai/claude-code @github/copilot

# ── 6. Miniconda 설치 (버전 고정) ───────────────────────────────────────────
ARG MINICONDA_VERSION=py312_24.11.1-0
RUN curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-${MINICONDA_VERSION}-Linux-x86_64.sh \
    -o /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh \
    && /opt/conda/bin/conda config --set channel_priority flexible \
    && /opt/conda/bin/conda install -y --override-channels \
       -c https://repo.anaconda.com/pkgs/main \
       -c https://repo.anaconda.com/pkgs/r \
       python=3.12 \
    && /opt/conda/bin/conda clean -afy

# conda auto_activate_base 비활성화 (사용자가 conda init 후 직접 활성화)
RUN /opt/conda/bin/conda config --set auto_activate_base false

# conda 명령만 전역에서 접근 가능하도록 심볼릭 링크
RUN ln -s /opt/conda/bin/conda /usr/local/bin/conda

# ── 7. PyTorch 2.7.1 + CUDA 12.8 ────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages \
    --timeout=300 \
    torch==2.7.1 \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu128

# ── 8. 도메인 라이브러리 ─────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages numpy==1.26.4

# 의료 영상 / 데이터 라이브러리
RUN pip3 install --no-cache-dir --break-system-packages \
    pandas==2.2.0 \
    scipy==1.14.1 \
    pyarrow==20.0.0 \
    joblib==1.3.2 \
    scikit-image==0.25.0 \
    matplotlib==3.10.0 \
    pillow \
    tqdm==4.66.4 \
    natsort

# nnU-Net / MONAI / 의료 영상
RUN pip3 install --no-cache-dir --break-system-packages \
    nnunetv2==2.5.1 \
    monai \
    SimpleITK==2.4.0 \
    nibabel==5.2.1 \
    nilearn==0.10.4 \
    nipype==1.8.6 \
    medpy

# Web / API
RUN pip3 install --no-cache-dir --break-system-packages \
    fastapi==0.116.1 \
    fastapi-utils==0.6.0 \
    uvicorn==0.29.0 \
    httpx==0.28.1 \
    pydantic==2.10.4 \
    pydantic-settings==2.7.1

# 유틸리티
RUN pip3 install --no-cache-dir --break-system-packages \
    tensorboard \
    python-dotenv==1.0.1 \
    requests==2.32.4 \
    urllib3==2.5.0 \
    six==1.17.0 \
    cryptography==46.0.3 \
    concurrent-log-handler==0.9.25 \
    notion-client==2.4.0 \
    openpyxl==3.1.5 \
    typing-inspect==0.9.0 \
    setuptools==78.1.1

# ── 9. JupyterLab + jupyter-server-proxy ────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages \
    jupyterlab \
    notebook \
    jupyter-server-proxy \
    ipykernel \
    pytorch_lightning

# ── 10. MOTD + README ────────────────────────────────────────────────────────
RUN printf '%s\n' \
    '╔══════════════════════════════════════════════════════════════════╗' \
    '║        Neuropean AI Workstation - JupyterLab Server              ║' \
    '╠══════════════════════════════════════════════════════════════════╣' \
    '║  Base    : nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04            ║' \
    '║  Python  : 3.12 (system) / 3.12 (conda base)                     ║' \
    '║  PyTorch : 2.7.1 + CUDA 12.8                                     ║' \
    '║  Conda   : /opt/conda                                            ║' \
    '╠══════════════════════════════════════════════════════════════════╣' \
    '║  [Conda] 환경 초기화 (최초 1회)                                     ║' \
    '║    conda init bash && source ~/.bashrc                           ║' \
    '║                                                                  ║' \
    '║  [Conda] 새 환경 생성                                              ║' \
    '║    conda create -n myenv python=3.12                             ║' \
    '║    conda activate myenv                                          ║' \
    '║    pip install -r requirements.txt                               ║' \
    '║                                                                  ║' \
    '║  [Jupyter] Conda 환경을 커널로 등록                                 ║' \
    '║    conda activate myenv                                          ║' \
    '║    pip install ipykernel                                         ║' \
    '║    python -m ipykernel install --user --name myenv               ║' \
    '║                                                                  ║' \
    '║  [Libs] 설치된 주요 라이브러리                                      ║' \
    '║    torch / torchvision / pytorch_lightning                       ║' \
    '║    nnunetv2 / monai / SimpleITK / nibabel                        ║' \
    '║    fastapi / uvicorn / pydantic                                  ║' \
    '║    numpy / pandas / scipy / scikit-image                         ║' \
    '║                                                                  ║' \
    '║  [Claude] Claude Code 사용                                        ║' \
    '║    claude                                                        ║' \
    '║                                                                  ║' \
    '║  [Git] 초기 설정                                                  ║' \
    '║    git config --global user.name "Your Name"                     ║' \
    '║    git config --global user.email "you@example.com"              ║' \
    '║                                                                  ║' \
    '║  [nnU-Net] 환경 변수 설정 (DataVolume 경로에 맞게 지정)              ║' \
    '║    export nnUNet_raw="/data/nnUNet_raw"                          ║' \
    '║    export nnUNet_preprocessed="/data/nnUNet_preprocessed"        ║' \
    '║    export nnUNet_results="/data/nnUNet_results"                  ║' \
    '║    # ~/.bashrc 에 추가하면 영구 적용됩니다                           ║' \
    '║                                                                  ║' \
    '║  [GPU] 상태 확인                                                  ║' \
    '║    nvidia-smi                                                    ║' \
    '║    python -c "import torch; print(torch.cuda.is_available())"    ║' \
    '╚══════════════════════════════════════════════════════════════════╝' \
    > /etc/motd \
    && echo 'cat /etc/motd' > /etc/profile.d/motd.sh \
    && chmod +x /etc/profile.d/motd.sh \
    && echo 'cat /etc/motd' >> /etc/bash.bashrc

RUN mkdir -p /opt/neuropean \
    && printf '%s\n' \
       '# 🧠 Neuropean AI Workstation' \
       '' \
       '> **Base**: `nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04`  ' \
       '> **Python**: 3.12 (system) / 3.12 (conda base)  ' \
       '> **PyTorch**: 2.7.1 + CUDA 12.8  ' \
       '> **Conda**: `/opt/conda`' \
       > /opt/neuropean/README.md

# ── 11. SSH 서버 설정 ────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    # 호스트 키 생성
    && ssh-keygen -A \
    # privilege separation 디렉토리
    && mkdir -p /run/sshd \
    # sshd_config 설정: 비밀번호 인증 허용
    && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    # PAM 없이도 로그인 가능하도록
    && sed -i 's/#UsePAM yes/UsePAM no/' /etc/ssh/sshd_config \
    && sed -i 's/UsePAM yes/UsePAM no/' /etc/ssh/sshd_config

# ── 12. Kubeflow 호환 jovyan 사용자 생성 ─────────────────────────────────────
RUN if getent passwd 1000 > /dev/null 2>&1; then \
        usermod -l jovyan -d /home/jovyan -m $(getent passwd 1000 | cut -d: -f1); \
    else \
        useradd -m -s /bin/bash -u 1000 jovyan; \
    fi \
    && usermod -aG users jovyan \
    && echo "jovyan ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    # jovyan 비밀번호 설정 (SSH 접속용)
    && echo "jovyan:jovyan" | chpasswd

# ── 13. jupyter-server-proxy로 code-server 등록 ─────────────────────────────
COPY jupyter_server_config.py /etc/jupyter/jupyter_server_config.py

# ── 14. entrypoint 스크립트 ──────────────────────────────────────────────────
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# ── 15. jovyan 환경 설정 ─────────────────────────────────────────────────────
USER jovyan
WORKDIR /home/jovyan

RUN mkdir -p /home/jovyan/.claude \
    && echo '{"autoUpdates":false}' > /home/jovyan/.claude/settings.json \
    && mkdir -p /home/jovyan/.local/share/code-server/extensions \
    && python3 -m ipykernel install --user --name python3 --display-name "Python 3.12 (CUDA 12.8)"

# ── 16. VS Code Server 사전 설치 ─────────────────────────────────────────────
# 로컬 VS Code의 commit hash 확인: code --version (두 번째 줄)
# 또는: curl -fsSL https://update.code.visualstudio.com/api/commits/stable/server-linux-x64
ARG VSCODE_COMMIT
RUN if [ -n "${VSCODE_COMMIT}" ]; then \
        mkdir -p /home/jovyan/.vscode-server/bin/${VSCODE_COMMIT} \
        && curl -fsSL \
           "https://update.code.visualstudio.com/commit:${VSCODE_COMMIT}/server-linux-x64/stable" \
           -o /tmp/vscode-server.tar.gz \
        && tar -xz --strip-components=1 \
           -C /home/jovyan/.vscode-server/bin/${VSCODE_COMMIT} \
           -f /tmp/vscode-server.tar.gz \
        && rm /tmp/vscode-server.tar.gz; \
    else \
        echo "[WARN] VSCODE_COMMIT 미지정 — VS Code Server 사전 설치 건너뜀"; \
    fi

ENV PATH="/usr/bin:/usr/local/bin:${PATH}"
ENV NB_PREFIX="/"

ARG IMAGE_VERSION=v2.4.2
LABEL maintainer="neuropean" \
      version="${IMAGE_VERSION}" \
      type="jupyter" \
      base="nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04" \
      python.version="3.12" \
      cuda.version="12.8.1" \
      node.version="20" \
      code-server.version="${CODE_SERVER_VERSION}" \
      vscode.commit="${VSCODE_COMMIT}"

EXPOSE 8888 22

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8888/api || exit 1

ENTRYPOINT ["tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--port=8888", \
     "--no-browser", \
     "--NotebookApp.token=''", \
     "--NotebookApp.password=''"]